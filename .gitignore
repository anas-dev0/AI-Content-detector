# --- Data: never commit images, shards or degraded copies (licences are mostly non-commercial) ---
data/raw/*
data/shards/*
data/degraded/*
data/own_2026/*
!data/**/.gitkeep
# Manifests (Parquet) and configs ARE tracked: they are small and define every experiment.

# --- Model artefacts ---
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
checkpoints/
wandb/
mlruns/
experiments/**/runs/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Secrets ---
.env
kaggle.json
